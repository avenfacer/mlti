APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSO BPS / Keycloak (names follow config/sso/sso_login.php)
# Register REDIRECT_URI below in the Keycloak client configuration.
KEYCLOAK_URL=
REALM=pegawai
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI="${APP_URL}/"
BPS_SSO_SCOPES="openid profile email"
BPS_SSO_USE_PKCE=false
# Use `client_secret_basic` only when required by the BPS SSO provider.
BPS_SSO_TOKEN_AUTH_METHOD=client_secret_post
# Keep TLS verification on. If BPS supplies an internal CA certificate, set its
# absolute PEM path in BPS_SSO_CA_BUNDLE instead of disabling verification.
BPS_SSO_VERIFY_SSL=true
BPS_SSO_CA_BUNDLE=
# Set BPS_SSO_PROFILE_PATH=data if the user-info response is wrapped as {"data": {...}}.
BPS_SSO_PROFILE_PATH=
# Ordered claims used to match users.nip_baru/users.nip_lama, then users.email.
BPS_SSO_NIP_CLAIMS="nip_baru,nip,preferred_username,username"
BPS_SSO_EMAIL_CLAIMS="email"
BPS_SSO_VERIFY_SSL=false
# Optional BPS_SSO_* endpoint overrides are supported by config/services.php.

GOOGLE_SERVICE_ENABLED=true
GOOGLE_SERVICE_ACCOUNT_JSON_LOCATION="./storage/app/google-credentials.json"

# Rekap Ruang Jambi ke Google Sheet (ID dari URL docs.google.com/spreadsheets/d/<ID>/edit)
RUANG_JAMBI_SHEET_ENABLED=false
RUANG_JAMBI_SHEET_ID=
RUANG_JAMBI_SHEET_TAB="Pengajuan MLTI"

RUANG_JAMBI_SHEET_ENABLED=true
RUANG_JAMBI_SHEET_ID=<ID dari URL docs.google.com/spreadsheets/d/<ID>/edit>
RUANG_JAMBI_SHEET_TAB="Pengajuan MLTI"